---
# Copy to secret.yml (gitignored) and fill in.

# Login for the web UI, grafana, and pushing to the last-minute git repos (user "admin")
mgmt_admin_password: CHANGEME

# ssh keys allowed to log in as each fleet's user. Fleets not listed get none.
fleet_authorized_keys:
  midatlantic: |
    ssh-ed25519 AAAA... someone@example
