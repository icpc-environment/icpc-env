#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "pyudev",
#     "urwid",
# ]
# ///
"""Write usb drives as they're plugged in, one write-usb per port at a time.

Each port gets a box showing its write-usb output, coloured by how it went.
Ports are named from a ports file (see --learn); without one, each port gets
a box the first time a drive shows up in it. With --check it runs check-usb
instead, to see whether drives hold the image without changing them.
"""
import argparse
import contextlib
import fcntl
import itertools
import math
import os
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
from enum import Enum
from pathlib import Path

import pyudev
import urwid

HERE = Path(__file__).resolve().parent
OUTPUT = HERE.parent.parent / "output"
DEFAULT_PORTS = HERE / "ports.toml"
UDEV_RULE = Path("/run/udev/rules.d/90-icpc-usb-station.rules")
LOCK = Path("/run/lock/icpc-usb-station.lock")

# A VIA VL811 hub (2109:8110 with 2109:2811) misses drives plugged in while
# its usb 2 half is runtime suspended, which Linux does as soon as nothing
# usb 2 is plugged into it: nothing gets logged and the drive never shows
# up, on usb 3 or 2, until the hub is woken some other way
HUB_RULE = 'SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{bDeviceClass}=="09", ATTR{power/control}="on"\n'
# Automounting would change drives while they're being written or checked
NO_AUTOMOUNT_RULE = 'SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{UDISKS_IGNORE}="1", ENV{UDISKS_AUTO}="0"\n'

# Started after a drive appears, so its partitions and model show up first
SETTLE_SECONDS = 2
# Reconnecting a drive that came up on usb 2: how long its socket's power
# stays off, and how long to wait for the drive to come back after
POWER_OFF_SECONDS = 2
RECONNECT_TIMEOUT_SECONDS = 15

DRY_RUN_WRITER = """
echo "Dry run: would write $2 to $1"
for i in $(seq 0 5 100); do printf '\\r%3d%%' $i; sleep 0.2; done
echo
echo "SUCCESS: $1 not written (dry run)"
"""


class State(Enum):
    PRESENT = "present"
    WAITING = "waiting"
    STARTING = "starting"
    WRITING = "writing"
    SUCCESS = "success"
    FAILED = "failed"
    USB2 = "usb2"


ATTRS = {
    State.PRESENT: "idle",
    State.WAITING: "idle",
    State.STARTING: "writing",
    State.WRITING: "writing",
    State.SUCCESS: "success",
    State.FAILED: "failed",
    State.USB2: "warning",
}


class OutputTerminal(urwid.Terminal):
    # Keys go to the station, not to write-usb, which never reads any
    def selectable(self):
        return False


def usb_device(device):
    """The usb device a drive belongs to, or None if it isn't on usb"""
    if device.properties.get("ID_BUS") != "usb":
        return None
    return device.find_parent("usb", "usb_device")


def usb3_twin(usb):
    """For a usb device on the usb 2 half of a port that also has usb 3, the
    sysfs path a usb 3 device in the same socket has, else None"""
    peer = Path(usb.sys_path) / "port/peer"
    try:
        if usb.attributes.asint("speed") >= 5000 or not peer.exists():
            return None
    except (KeyError, ValueError):
        return None
    # e.g. .../usb2/2-3/2-3.4/2-3.4:1.0/2-3.4-port4 -> .../usb2/2-3/2-3.4/2-3.4.4,
    # or .../usb2/2-0:1.0/usb2-port9 -> .../usb2/2-9 for the controller's own ports
    peer = peer.resolve()
    hub = peer.parent.parent
    number = peer.name.rsplit("port", 1)[1]
    name = f"{hub.name[3:]}-{number}" if hub.name.startswith("usb") else f"{hub.name}.{number}"
    return "/" + str((hub / name).relative_to("/sys"))


def usb_port(device):
    """The usb port a drive is plugged into, as the sysfs path of its usb device.

    udev's ID_PATH would be simpler but leaves out the bus, and a usb 3
    controller puts its usb 2 and usb 3 ports on separate buses that reuse the
    same port numbers. A drive that came up on the usb 2 half of a usb 3 port
    counts as being in that port.
    """
    usb = usb_device(device)
    # Not `if usb`: a pyudev Device's truthiness goes through its deprecated
    # mapping interface and prints a warning over the screen
    if usb is None:
        return None
    return usb3_twin(usb) or usb.device_path


def disk_size(device):
    """A disk's size in bytes, 0 for no media, or for a drive unplugged
    before its udev events get handled, whose sysfs entry is already gone"""
    try:
        return device.attributes.asint("size") * 512
    except (KeyError, ValueError):
        return 0


def drive_label(device):
    vendor = device.properties.get("ID_VENDOR", "").replace("_", " ")
    model = device.properties.get("ID_MODEL", "").replace("_", " ")
    size = disk_size(device) / 1e9
    label = f"{vendor} {model} ({size:.0f} GB)".strip()
    usb = usb_device(device)
    if usb is not None and usb3_twin(usb):
        label += ", on usb 2 in a usb 3 port (replug it for usb 3)"
    return label


class Port:
    def __init__(self, station, name):
        self.station = station
        self.name = name
        self.state = State.WAITING
        self.devname = None
        self.started = None
        self.finished = None
        self.terminal = None
        self.status_file = None
        self.alarm = None
        # Socket ports switched off to reconnect a drive that came up on usb 2
        self.powered_off = []
        self.reconnecting = False
        self.reconnected = False

        self.message = urwid.Text("")
        self.body = urwid.WidgetPlaceholder(urwid.Filler(self.message, valign="top"))
        self.box = urwid.LineBox(self.body, title=name, title_align="left")
        self.widget = urwid.AttrMap(self.box, "idle")
        self.show(State.WAITING, "Waiting for a drive")

    def show(self, state, message=None):
        self.state = state
        self.widget.set_attr_map({None: ATTRS[state]})
        if message is not None:
            self.message.set_text(message)
            self.body.original_widget = urwid.Filler(self.message, valign="top")
        self.update_title()
        self.station.update_status()

    def update_title(self):
        title = self.name
        if self.devname:
            title += f" {self.devname}"
        if self.state in (State.WRITING, State.SUCCESS, State.FAILED):
            elapsed = int((self.finished or time.time()) - self.started)
            title += f" - {self.station.labels[self.state]} {elapsed // 60}m{elapsed % 60:02d}s"
        elif self.state == State.USB2:
            title += " - USB 2"
        self.box.set_title(title)

    def already_present(self, device):
        self.devname = device.device_node
        self.show(State.PRESENT, f"{drive_label(device)} was already plugged in.\n"
                                 "Unplug it and plug it back in to write it.")

    def inserted(self, device):
        if self.state not in (State.WAITING, State.SUCCESS, State.FAILED, State.USB2) and not self.reconnecting:
            return
        # Events from before the socket was switched off, e.g. the change
        # after the kernel reads the drive's partition table
        if self.powered_off and self.alarm:
            return
        self.cancel_alarm()
        self.power_on()
        self.reconnecting = False
        self.devname = device.device_node
        self.started = self.finished = None
        usb = usb_device(device)
        if usb is not None and usb3_twin(usb):
            if not self.reconnected:
                self.reconnect(device, usb)
                return
            self.show(State.USB2, f"{drive_label(device)}\n"
                                  f"It only connected at usb 2 speed, so it's not being {self.station.doing}.\n"
                                  "Unplug it and plug it back in.")
            return
        self.show(State.STARTING, f"{drive_label(device)}\nStarting in {SETTLE_SECONDS}s...")
        self.alarm = self.station.loop.set_alarm_in(SETTLE_SECONDS, lambda *_: self.start())

    def reconnect(self, device, usb):
        """Power cycle both halves of the drive's socket, like unplugging it
        and plugging it back in, in the hope it comes back on usb 3"""
        self.reconnected = self.reconnecting = True
        self.show(State.STARTING, f"{drive_label(device)}\nSeen on usb 2, reconnecting it to try for usb 3...")
        port = (Path(usb.sys_path) / "port").resolve()
        try:
            for p in (port, (port / "peer").resolve()):
                (p / "disable").write_text("1")
                self.powered_off.append(p)
        except OSError as e:
            self.power_on()
            self.reconnecting = False
            self.show(State.USB2, f"{drive_label(device)}\nIt's on usb 2, and reconnecting it failed ({e}).\n"
                                  "Unplug it and plug it back in.")
            return
        self.alarm = self.station.loop.set_alarm_in(POWER_OFF_SECONDS, lambda *_: self.reconnect_wait())

    def reconnect_wait(self):
        self.power_on()
        self.alarm = self.station.loop.set_alarm_in(RECONNECT_TIMEOUT_SECONDS, lambda *_: self.reconnect_timeout())

    def reconnect_timeout(self):
        self.alarm = None
        # Gone, so plugging it in again is a fresh start
        self.reconnecting = self.reconnected = False
        self.devname = None
        self.show(State.USB2, "Reconnected it to try for usb 3, but it didn't come back.\n"
                              "Unplug it and plug it back in.")

    def power_on(self):
        # The usb 3 half first, so the drive finds it there when the power comes back
        for p in reversed(self.powered_off):
            with contextlib.suppress(OSError):
                (p / "disable").write_text("0")
        self.powered_off = []

    def cancel_alarm(self):
        if self.alarm:
            self.station.loop.remove_alarm(self.alarm)
            self.alarm = None

    def start(self):
        self.alarm = None
        fd, self.status_file = tempfile.mkstemp(prefix="usb-station-")
        os.close(fd)
        os.unlink(self.status_file)
        env = dict(os.environ, STATUS_FILE=self.status_file)
        command = ["/bin/bash", "-c", '"$@"; echo $? > "$STATUS_FILE"', "bash",
                   *self.station.writer, self.devname, str(self.station.image_dir)]
        self.terminal = OutputTerminal(command, env=env, main_loop=self.station.loop.event_loop)
        urwid.connect_signal(self.terminal, "closed", lambda *_: self.closed())
        self.body.original_widget = self.terminal
        self.started = time.time()
        self.show(State.WRITING)

    def closed(self):
        self.finished = time.time()
        try:
            code = int(Path(self.status_file).read_text())
            Path(self.status_file).unlink()
        except (OSError, ValueError):
            code = None
        # The finished output stays up, under a title saying how it went. As
        # text rather than the terminal, which stops resizing once its process
        # exits and then breaks the layout when the window changes size
        rows = (b"".join(text for _, _, text in row).decode(errors="replace").rstrip()
                for row in self.terminal.term.content())
        self.message.set_text("\n".join(rows).strip("\n"))
        self.body.original_widget = urwid.Filler(self.message, valign="bottom")
        self.show(State.SUCCESS if code == 0 else State.FAILED)
        self.terminal = None
        self.station.bell()

    def removed(self):
        # Switching the socket off unplugs the drive too
        if self.reconnecting:
            return
        self.cancel_alarm()
        self.reconnected = False
        if self.state == State.WRITING:
            self.terminal.terminate()
            self.finished = time.time()
            self.devname = None
            if self.station.checking:
                self.show(State.FAILED, "Unplugged while checking.\nPlug it back in to check it again.")
            else:
                self.show(State.FAILED, "Unplugged while writing, this drive is not usable.\n"
                                        "Plug it back in to write it again.")
            return
        self.devname = None
        self.show(State.WAITING, "Waiting for a drive")

    def abort(self):
        if self.terminal:
            self.terminal.terminate()
        self.power_on()


class Station:
    def __init__(self, args):
        self.image_dir = args.image_dir
        self.columns = args.columns
        self.loop_devices = args.loop_devices
        self.checking = args.check
        if args.check:
            self.writer = [str(HERE / "check-usb")]
            if args.read_all:
                self.writer.append("--read-all")
            if args.loop_devices:
                self.writer.append("--any-transport")
            self.labels = {State.WRITING: "CHECKING", State.SUCCESS: "MATCHES", State.FAILED: "FAILED"}
            self.doing = "checked"
        elif args.dry_run:
            self.writer = ["/bin/bash", "-c", DRY_RUN_WRITER, "dry-run"]
        else:
            self.writer = [str(HERE / "write-usb")]
            if args.no_verify:
                self.writer.append("--no-verify")
            if args.max_size:
                self.writer += ["--max-size", str(args.max_size)]
            if args.loop_devices:
                self.writer.append("--any-transport")
        if not args.check:
            self.labels = {State.WRITING: "WRITING", State.SUCCESS: "SUCCESS", State.FAILED: "FAILED"}
            self.doing = "written"

        self.paths = {}  # usb_port() -> port name
        self.ports = {}  # port name -> Port
        self.fixed_ports = args.ports_file.exists()
        self.loop = None
        self.quit_armed = False

        self.status = urwid.Text("")
        self.notice = urwid.Text("")
        self.grid = urwid.WidgetPlaceholder(urwid.SolidFill(" "))
        footer = urwid.AttrMap(urwid.Pile([self.notice, self.status]), "status")
        self.frame = urwid.Frame(self.grid, footer=footer)

        if self.fixed_ports:
            for name, paths in load_ports(args.ports_file).items():
                self.add_port(name, paths)
        else:
            self.note("No ports file, so each port gets a box the first time a drive is plugged into it")

    def add_port(self, name, paths):
        self.ports[name] = Port(self, name)
        for path in paths:
            self.paths[path] = name
        self.layout()

    def layout(self):
        ports = [p.widget for p in self.ports.values()]
        if not ports:
            self.grid.original_widget = urwid.Filler(
                urwid.Text("Plug a drive in to start", align="center"))
            return
        columns = self.columns or math.ceil(math.sqrt(len(ports)))
        rows = [urwid.Columns(ports[i:i + columns]) for i in range(0, len(ports), columns)]
        # Keep a short last row the same width per box as the others
        missing = columns - len(ports) % columns
        if missing != columns:
            rows[-1] = urwid.Columns(ports[-(len(ports) % columns):] + [urwid.SolidFill(" ")] * missing)
        self.grid.original_widget = urwid.Pile(rows)

    def note(self, text):
        self.notice.set_text(text)

    def update_status(self):
        counts = {s: sum(p.state == s for p in self.ports.values()) for s in State}
        busy = counts[State.WRITING] + counts[State.STARTING]
        if self.checking:
            done = f"checking {busy}, match {counts[State.SUCCESS]}"
        else:
            done = f"writing {busy}, done {counts[State.SUCCESS]}"
        usb2 = f", on usb 2 {counts[State.USB2]}" if counts[State.USB2] else ""
        self.status.set_text(
            f"{self.image_dir.name} | {done}, failed {counts[State.FAILED]}{usb2}, "
            f"empty {counts[State.WAITING]} | q to quit")

    def bell(self):
        sys.stdout.write("\a")
        sys.stdout.flush()

    def port_for(self, device):
        """The Port a drive is plugged into, if it's one the station writes"""
        if self.loop_devices:
            if device.sys_name.startswith("loop"):
                path = device.device_node
            else:
                return None
        else:
            path = usb_port(device)
            if not path:
                return None

        if path not in self.paths:
            if self.fixed_ports:
                self.note(f"{drive_label(device)} is on a port not in the ports file: {path}")
                return None
            self.add_port(f"Port {len(self.ports) + 1}", [path])
        return self.ports[self.paths[path]]

    def on_udev(self):
        for device in iter(lambda: self.monitor.poll(timeout=0), None):
            # Quitting here would take every write in progress with it
            try:
                self.on_device(device)
            except Exception as e:
                self.note(f"Couldn't handle {device.action} of {device.device_node}: {e!r}")

    def on_device(self, device):
        # Loop devices and card readers report media coming and going as a
        # change in size rather than add and remove
        size = disk_size(device) if device.action != "remove" else 0
        if device.action == "remove" or (device.action == "change" and size == 0):
            port = self.port_for_known(device)
            if port:
                port.removed()
        elif device.action in ("add", "change") and size > 0:
            port = self.port_for(device)
            if port and (device.action == "add" or port.state == State.WAITING or port.reconnecting):
                port.inserted(device)

    def port_for_known(self, device):
        for port in self.ports.values():
            if port.devname == device.device_node:
                return port
        return None

    def on_key(self, key):
        if key not in ("q", "Q"):
            return
        busy = [p for p in self.ports.values() if p.state in (State.STARTING, State.WRITING)]
        if busy and not self.quit_armed:
            self.quit_armed = True
            doing = "checked" if self.checking else "written"
            self.note(f"{len(busy)} drives are still being {doing}, press q again to stop them and quit")
            self.loop.set_alarm_in(5, lambda *_: setattr(self, "quit_armed", False))
            return
        for port in self.ports.values():
            port.abort()
        # Some terminals ignore the alternate screen urwid draws on, so it
        # would stay up with the shell prompt on top; elsewhere this only
        # clears the alternate screen on its way out
        self.loop.screen.write("\x1b[2J\x1b[H")
        self.loop.screen.flush()
        raise urwid.ExitMainLoop()

    def tick(self, *_):
        for port in self.ports.values():
            if port.state == State.WRITING:
                port.update_title()
        self.loop.set_alarm_in(1, self.tick)

    def run(self):
        palette = [
            ("idle", "default", "default"),
            ("writing", "light blue", "default"),
            ("success", "light green", "default"),
            ("failed", "light red", "default"),
            ("warning", "yellow", "default"),
            ("status", "white", "dark blue"),
        ]
        context = pyudev.Context()
        self.monitor = pyudev.Monitor.from_netlink(context)
        self.monitor.filter_by(subsystem="block", device_type="disk")
        self.monitor.start()

        self.loop = urwid.MainLoop(self.frame, palette, unhandled_input=self.on_key, handle_mouse=False)
        self.loop.watch_file(self.monitor.fileno(), self.on_udev)

        for device in context.list_devices(subsystem="block", DEVTYPE="disk"):
            if disk_size(device) > 0:
                port = self.port_for(device)
                # Checking doesn't change a drive, so there's no need to wait
                # for it to be plugged in again
                if port and self.checking:
                    port.inserted(device)
                elif port:
                    port.already_present(device)
        self.layout()
        self.update_status()
        self.tick()
        try:
            self.loop.run()
        finally:
            # Never leave a socket switched off, even if the station crashes
            for port in self.ports.values():
                port.power_on()


def load_ports(path):
    return tomllib.loads(path.read_text()).get("ports", {})


def save_ports(path, ports):
    def quote(s):
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    lines = ["# usb ports for tools/usb/station, from `just usb learn`", "[ports]"]
    for name, paths in ports.items():
        lines.append(f"{quote(name)} = [{', '.join(quote(p) for p in paths)}]")
    path.write_text("\n".join(lines) + "\n")
    if "SUDO_UID" in os.environ:
        os.chown(path, int(os.environ["SUDO_UID"]), int(os.environ["SUDO_GID"]))


@contextlib.contextmanager
def udev_setup(no_automount):
    """While running, usb hubs stay awake and, with no_automount, nothing
    automounts usb drives; hubs go back to how they were afterwards"""
    hubs = {}
    for device in Path("/sys/bus/usb/devices").iterdir():
        control = device / "power/control"
        if (device / "bDeviceClass").exists() and (device / "bDeviceClass").read_text().strip() == "09":
            hubs[control] = control.read_text().strip()
            control.write_text("on")
    UDEV_RULE.parent.mkdir(parents=True, exist_ok=True)
    UDEV_RULE.write_text(HUB_RULE + (NO_AUTOMOUNT_RULE if no_automount else ""))
    subprocess.run(["udevadm", "control", "--reload"], check=False)
    try:
        yield
    finally:
        UDEV_RULE.unlink(missing_ok=True)
        subprocess.run(["udevadm", "control", "--reload"], check=False)
        for control, value in hubs.items():
            # Gone if the hub was unplugged or power cycled meanwhile
            with contextlib.suppress(OSError):
                control.write_text(value)


def learn(path):
    """Name ports by plugging a drive into each in turn"""
    ports = load_ports(path) if path.exists() else {}
    context = pyudev.Context()
    monitor = pyudev.Monitor.from_netlink(context)
    monitor.filter_by(subsystem="block", device_type="disk")
    print(f"Saving ports to {path}")
    print("A usb 2 drive in a usb 3 port shows up as a different port, so name each port")
    print("with both kinds of drive if you have both. Ctrl-C when done.\n")
    try:
        for n in itertools.count(len(ports) + 1):
            print("Plug a drive into a port...")
            for device in iter(monitor.poll, None):
                if device.action == "add" and usb_port(device):
                    break
            port = usb_port(device)
            known = [name for name, paths in ports.items() if port in paths]
            print(f"  {drive_label(device)} at {port}")
            if known:
                print(f"  That's {known[0]} already")
            else:
                name = input(f"  Name for this port [Port {n}]: ").strip() or f"Port {n}"
                ports.setdefault(name, []).append(port)
                save_ports(path, ports)
                print(f"  Saved as {name}")
            print("Unplug it.\n")
            devname = device.device_node
            for device in iter(monitor.poll, None):
                if device.action == "remove" and device.device_node == devname:
                    break
    except (KeyboardInterrupt, EOFError):
        print()
    print(f"{len(ports)} ports in {path}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("image_dir", type=Path, nargs="?",
                        help="output of tools/usb/prepare (default: the newest in output/)")
    parser.add_argument("--ports-file", type=Path, default=DEFAULT_PORTS,
                        help=f"port names (default {DEFAULT_PORTS.relative_to(HERE.parent.parent)})")
    parser.add_argument("--learn", action="store_true", help="name ports by plugging a drive into each")
    parser.add_argument("--columns", type=int, help="boxes per row (default about square)")
    parser.add_argument("--dry-run", action="store_true", help="show what would happen without writing drives")
    parser.add_argument("--no-verify", action="store_true", help="pass --no-verify to write-usb")
    parser.add_argument("--max-size", type=int, metavar="GIB", help="pass --max-size to write-usb")
    parser.add_argument("--loop-devices", action="store_true",
                        help="write loop devices as they're attached instead of usb drives, for testing")
    parser.add_argument("--check", action="store_true",
                        help="check whether drives hold the image instead of writing them")
    parser.add_argument("--read-all", action="store_true",
                        help="with --check, also read back everything the image wrote (minutes per drive)")
    args = parser.parse_args()
    if args.read_all and not args.check:
        parser.error("--read-all only goes with --check")
    if args.check and (args.dry_run or args.no_verify or args.max_size):
        parser.error("--dry-run, --no-verify and --max-size are for writing, not --check")

    if os.geteuid() != 0:
        sys.exit("station needs root to write drives")
    # So closing the window still runs the cleanup in udev_setup
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(1))

    if args.learn:
        with udev_setup(no_automount=False):
            learn(args.ports_file)
        return
    if not args.image_dir:
        prepared = sorted(OUTPUT.glob("*_image-amd64.img.d"), key=lambda d: d.stat().st_mtime)
        if not prepared:
            sys.exit("Nothing prepared in output/, run tools/usb/prepare first")
        args.image_dir = prepared[-1]
    if not (args.image_dir / "manifest.json").exists():
        sys.exit(f"{args.image_dir} has no manifest.json, run tools/usb/prepare first")
    args.image_dir = args.image_dir.resolve()

    # Two stations would both act on every drive plugged in, and the first to
    # quit would take the udev rule below away from the other
    with open(LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit("Another station is already running; quit it first")
        run_station(args)


def run_station(args):
    with udev_setup(no_automount=not args.dry_run):
        Station(args).run()


if __name__ == "__main__":
    main()
