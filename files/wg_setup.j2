#!/bin/bash
set -euo pipefail
source /icpc/CONFIG

# The fleet contest.conf was registered in
REGISTERED=/etc/wireguard/contest.fleet
# From the site's config, written by the setup wizard. Fleets from contestforge
# only let a site's machines register with it; static ones take anyone
TOKEN=/etc/icpc/enrollment-token
HOST_KEY=/etc/ssh/ssh_host_ed25519_key.pub
HOST_CERT=/etc/ssh/ssh_host_ed25519_key-cert.pub

# Install the host certificate in a ping response, if it's new and for our host key
install_host_certificate() {
  local cert tmp
  cert=$(echo "$1" | jq -r '.host_certificate // empty' 2>/dev/null || true)
  if [ -z "$cert" ] || [ "$cert" = "$(cat $HOST_CERT 2>/dev/null || true)" ]; then
    return 0
  fi
  tmp=$(mktemp /etc/ssh/.host-cert.XXXXXX)
  echo "$cert" > "$tmp"
  if [ "$(ssh-keygen -L -f "$tmp" 2>/dev/null | sed -n 's/^ *Public key: [^ ]* //p')" != "$(ssh-keygen -l -f $HOST_KEY | cut -d' ' -f2)" ]; then
    echo "wg-fleet sent a host certificate that isn't for this machine's host key, ignoring it"
    rm -f "$tmp"
    return 0
  fi
  chmod 0644 "$tmp"
  mv "$tmp" $HOST_CERT
  echo "HostCertificate $HOST_CERT" > /etc/ssh/sshd_config.d/ssh_host_cert.conf
  systemctl reload ssh
  echo "Installed a host certificate: $(ssh-keygen -L -f $HOST_CERT | grep -A1 Principals: | tail -1 | xargs)"
}

# A tunnel into another fleet (the setup fleet, until the wizard sets this
# site's) has to go, or the ping below would keep it forever
if [ -f /etc/wireguard/contest.conf ] && [ "$(cat $REGISTERED 2>/dev/null)" != "$FLEET" ]; then
  echo "Registered in fleet $(cat $REGISTERED 2>/dev/null || echo '(unknown)'), moving to $FLEET"
  wg-quick down contest || true
  systemctl stop 'wstunnel@*'
  rm -f /etc/wireguard/contest.conf $REGISTERED /run/wg_setup-vpn-hostname-updated
fi

# Try to start wireguard if we have a config for it and it isn't already up
if [ -f /etc/wireguard/contest.conf ] && ! wg show contest >/dev/null 2>&1; then
  wg-quick up contest || true
  sleep 3 # make sure it has some time to come online
fi


# Nothing to do if the VPN is already up/contestmanager.icpcnet.internal is reachable
if ping -w3 -c1 contestmanager.icpcnet.internal >/dev/null 2>&1 ; then
  # Exit if we've recorded our hostname in the last hour
  [ -n "$(find /run/wg_setup-vpn-hostname-updated -mmin -60 2>/dev/null)" ] && exit 0

  # Send a ping request to register our hostname and renew our host certificate
  response=$(curl --fail -sS -X POST https://contestmanager.icpcnet.internal/fleet/$FLEET/ping  --header "Content-Type: application/json" -d '{"hostname": "'"$HOSTNAME"'"}' -k)
  install_host_certificate "$response"
  touch /run/wg_setup-vpn-hostname-updated
  exit 0
fi

echo "contestmanager.icpcnet.internal not reachable, reconfiguring VPN"
rm -f /run/wg_setup-vpn-hostname-updated

# Network is broken/not configured yet, bring it down so we can try to re-initialize it
wg-quick down contest || true

# On stdin, since curl's arguments are visible to every user
registration=$(jq -n \
  --arg site "${SITE:-}" \
  --arg token "$(cat $TOKEN 2>/dev/null || true)" \
  --arg host_key "$(cut -d' ' -f1,2 $HOST_KEY)" \
  '{host_key: $host_key} + (if $site != "" then {site: $site} else {} end) + (if $token != "" then {token: $token} else {} end)')
wg_config=$(echo "$registration" | curl --fail -sS -X POST https://$REMOTE_MANAGEMENT_SERVER/fleet/$FLEET/register \
  --header "Content-Type: application/json" --data @-)

if [ $? != 0 ]; then
  exit 1 # failed, exit so it tries again
fi

echo "$wg_config" | jq -r .config > /etc/wireguard/contest.conf
echo "$FLEET" > $REGISTERED
wg-quick up contest

server_ip=$(echo "$wg_config" | jq -r .server_ip)
server_port=$(echo "$wg_config" | jq -r .port)

# Update the hosts file with the server ip and contestmanager.icpcnet.internal hostname
if ! grep -q "contestmanager.icpcnet.internal" /etc/hosts; then
  echo "$server_ip contestmanager.icpcnet.internal contestmanager" >> /etc/hosts
else
  sed -ie "s/^.*contestmanager.icpcnet.internal.*$/${server_ip} contestmanager.icpcnet.internal contestmanager/" /etc/hosts
fi

# Wait a few moments
sleep 5

# Try to ping the contest management server
if ping -w3 -c1 contestmanager.icpcnet.internal >/dev/null 2>&1 ; then
  exit 0
fi

# Bring it down so we can try wstunnel instead
wg-quick down contest || true

# Stop all instances of wstunnel
systemctl stop 'wstunnel@*'
systemctl start "wstunnel@$server_port"

# Wrap the connection with wstunnel (and set MTU to 1300)
sed -i -e 's/^Endpoint.*/Endpoint=127.0.0.10:51820/' /etc/wireguard/contest.conf
sed -i -e '/Address/a\MTU = 1300' /etc/wireguard/contest.conf

# Bring it back up
wg-quick up contest

# Check if it's alive now
sleep 5
if ping -w3 -c1 contestmanager.icpcnet.internal >/dev/null 2>&1 ; then
  exit 0
fi

# Report an exit failure if it was still down at this point
exit 1
