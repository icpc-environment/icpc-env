#!/usr/bin/python3

#usage: pcpr North.java
#usage: pcpr --output=files.ps *.java
#usage: pcpr -P printer *.cpp
#usage: pcpr --portrait -1 North.hs     [ For those with difficulty with the small print.]

#This script prints contestant source with a header on every page, so a listing
#picked up off the printer can be handed back to the right team:
#
#   1)  file name
#   2)  page i of n
#   3)  Contents of the files /icpc/SITE /icpc/TEAM
#

# This uses paps rather than enscript. enscript only speaks Latin-1, so source
# (or a team name) containing any non-ASCII character prints as garbage; paps
# renders through pango and is UTF-8 clean.
#
# paps has no equivalent of enscript's --pretty-print, so listings are no
# longer syntax highlighted.

import os
import subprocess
import sys

sitefile = "/icpc/SITE"
teamfile = "/icpc/TEAM"


def read_file(path):
    try:
        with open(path) as handle:
            return handle.read().strip() or "[none]"
    except OSError:
        return "[none]"


site = read_file(sitefile)
team = read_file(teamfile)

# -MLetter: we assume US printers and generate letter size pages and not A4
options = ["--paper=letter", "--columns=2", "--landscape", "--font=Monospace 8", "--header"]
printer = None
output = None
files = []

args = sys.argv[1:]
while args:
    arg = args.pop(0)
    if arg == "-P":
        printer = args.pop(0) if args else None
    elif arg.startswith("-P"):
        printer = arg[2:]
    elif arg.startswith("--output="):
        output = arg.split("=", 1)[1]
    elif arg == "--portrait":
        options = [o for o in options if o != "--landscape"]
    elif arg in ("-1", "-2"):
        options = [o for o in options if not o.startswith("--columns=")]
        options.append("--columns=" + arg[1:])
    else:
        files.append(arg)

if not files:
    sys.exit("usage: pcpr [-P printer] [--output=file] [--portrait] [-1|-2] file [...]")

lpr = ["/usr/bin/lpr"]
if printer is not None:
    lpr += ["-P", printer]

if os.path.exists("/usr/bin/icpc-printer") and output is None:
    text = ["-o", "prettyprint", "-o", "cpi=14", "-o", "lpi=8"]
    if "--landscape" in options:
        text += ["-o", "landscape"]
    text += ["-o", "columns=" + next(o for o in options if o.startswith("--columns=")).split("=", 1)[1]]
    for path in files:
        subprocess.run(lpr + text + ["-T", os.path.basename(path), path], check=True)
    sys.exit(0)

for path in files:
    # paps draws the title on every page, next to the page numbers
    title = "%s; team=%s; site=%s" % (os.path.basename(path), team, site)
    paps = ["/usr/bin/paps"] + options + ["--title=" + title, path]

    if output is not None:
        with open(output, "ab") as handle:
            subprocess.run(paps, stdout=handle, check=True)
    else:
        # No shell here on purpose: team names routinely contain quotes
        rendered = subprocess.run(paps, stdout=subprocess.PIPE, check=True)
        subprocess.run(lpr, input=rendered.stdout, check=True)
