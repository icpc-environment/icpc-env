#!/usr/bin/python3
"""Make this machine match /icpc/config.json. Run as root.

Writes the files other tools read (/icpc/TEAM, SITE, CONTEST, CONFIG, ...), and
sets the allowed sites, hostname, admin ssh keys, wallpaper, Firefox policies
and autostart, and printers. A section whose settings aren't in the config is
left alone, so this is safe before setup, when there's no team or printers yet. Prints what
failed and exits 1 if anything did, after trying the rest.

usage: icpc-apply [--no-start]

--no-start  enable services without starting them, for image builds
"""
import json
import re
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import icpcconfig  # noqa: E402

ICPC = Path("/icpc")
GENERATED = "# Generated from /icpc/config.json by /icpc/scripts/icpc-apply"
TEAM_FILES = ["TEAMID", "TEAMNAME", "TEAMAFFILIATION"]

# With icpc-printer (playbooks/icpc-printer.yml), contestants print to its "icpc"
# queue and only it may submit to the real printers configured here
ICPC_PRINTER = Path("/usr/bin/icpc-printer").exists()
RESTRICTED = ["-u", "allow:icpc-printer", "-o", "printer-op-policy=icpc-restricted"] if ICPC_PRINTER else []
ERROR_POLICY = ["-o", "printer-error-policy=abort-job"] if ICPC_PRINTER else []

errors = []


def run(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        errors.append(f"{' '.join(cmd)} exited {p.returncode}: {(p.stderr or p.stdout).strip()}")
    return p.returncode == 0


def replace_block(lines, begin, end, block):
    """lines with the begin...end block replaced by block (dropped if empty)"""
    if begin in lines:
        start = lines.index(begin)
        lines = lines[:start] + lines[lines.index(end, start) + 1:]
    return lines + ([begin] + block + [end] if block else [])


def write(name, text):
    path = ICPC / name
    if text is None:
        path.unlink(missing_ok=True)
    else:
        path.write_text(text + "\n")


def env_value(value):
    # Both `source` in bash and systemd's EnvironmentFile= understand this quoting
    value = "" if value is None else str(value)
    for c in '\\"$`':
        value = value.replace(c, "\\" + c)
    return f'"{value}"'


# Both end up in URLs
MANAGEMENT_SERVER_RE = r"[A-Za-z0-9.-]+"
FLEET_RE = r"[a-z0-9][a-z0-9_-]{0,31}"


def management(config):
    """The management server and fleet this machine uses, and whether for the VPN and last-minute ansible"""
    m = config.get("management") or {}
    if not isinstance(m, dict):
        m = {"server": m}
    server, fleet = m.get("server"), m.get("fleet")
    if not (server is None or isinstance(server, str) and re.fullmatch(MANAGEMENT_SERVER_RE, server)) \
            or not (fleet is None or isinstance(fleet, str) and re.fullmatch(FLEET_RE, fleet)):
        errors.append(f"management {m!r} isn't a valid server and fleet")
        server = fleet = None
    return {"server": server, "fleet": fleet, "vpn": bool(m.get("vpn")), "lastminute": bool(m.get("lastminute"))}


# ansible-pull passes the URL through a shell, so nothing that means anything to one
PULL_URL_RE = r"https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~%/-]*)?"


def ansible_pull_url(config, mgmt):
    """The last-minute playbook's git repo: ansible_pull_url, else the fleet's repo on the management server"""
    url = config.get("ansible_pull_url")
    if url is None:
        server, fleet = mgmt["server"], mgmt["fleet"]
        return f"https://{server}/git/{fleet}.git" if server and fleet else None
    if not isinstance(url, str) or not re.fullmatch(PULL_URL_RE, url):
        errors.append(f"ansible_pull_url {url!r} isn't a plain https URL")
        return None
    return url


def apply_files(config, mgmt, pull_url):
    team = config.get("team")
    write("CONTEST", config.get("contest") or None)
    write("SITE", config.get("site", "default site"))
    if team:
        write("TEAMID", team["id"])
        write("TEAMNAME", team["name"])
        write("TEAMAFFILIATION", team["affiliation"])
        write("TEAM", f"{team['id']} - {team['name']} ({team['affiliation']})")
    else:
        for name in TEAM_FILES:
            write(name, None)
        write("TEAM", "default team")

    # Sourced by self_test and wg_setup, and the EnvironmentFile of the VPN and ansible-pull units
    env = {
        "REMOTE_MANAGEMENT_SERVER": mgmt["server"],
        "FLEET": mgmt["fleet"],
        "CONTEST": config.get("contest"),
        "ANSIBLE_PULL_URL": pull_url,
    }
    if "site" in config:
        env["SITE"] = config["site"]
    if team:
        env.update(TEAM_ID=team["id"], TEAM_NAME=team["name"], TEAM_AFFILIATION=team["affiliation"])
    write("CONFIG", GENERATED + "\n" + "\n".join(f"{k}={env_value(v)}" for k, v in env.items()))


def apply_papersize(papersize):
    Path("/etc/papersize").write_text(papersize + "\n")


def apply_timezone(timezone):
    zoneinfo = Path("/usr/share/zoneinfo") / timezone
    if not zoneinfo.is_file():
        errors.append(f"unknown timezone {timezone}")
        return
    localtime = Path("/etc/localtime")
    localtime.unlink(missing_ok=True)
    localtime.symlink_to(zoneinfo)
    Path("/etc/timezone").write_text(timezone + "\n")


def apply_language_scripts(scripts):
    """compilec, runjava etc. in /usr/local/bin, so they match how the judge compiles and runs"""
    bin_dir = Path("/usr/local/bin")
    for path in bin_dir.iterdir():
        if path.name not in scripts and path.is_file() and not path.is_symlink():
            with open(path, "rb") as f:
                if GENERATED.encode() in f.read(200):
                    path.unlink()
    for name, command in scripts.items():
        if not re.fullmatch(r"[A-Za-z0-9_.+-]+", name):
            errors.append(f"bad language script name {name!r}")
            continue
        path = bin_dir / name
        path.write_text(f"#!/bin/bash\n{GENERATED}\n{command}\n")
        path.chmod(0o755)


# Clients a contest can pick for `submit`, installed by playbooks/ccs
SUBMIT_CLIENTS = {
    "kattis": Path("/usr/local/bin/kattis"),
    "pc2": Path("/usr/local/bin/pc2submit"),
    "domjudge": Path("/usr/local/bin/domjudge-submit"),
}


def apply_submit(submit):
    client = submit.get("client")
    if client:
        target = SUBMIT_CLIENTS.get(client)
        if target is None or not target.exists():
            errors.append(f"submit client {client} isn't installed (see playbooks/ccs)")
        else:
            link = Path("/usr/local/bin/submit")
            link.unlink(missing_ok=True)
            link.symlink_to(target)

    # Both pc2submit and DOMjudge's client read SUBMITBASEURL; pc2_base_url is the old name
    base_url = submit.get("base_url", submit.get("pc2_base_url"))
    Path("/etc/profile.d/pc2submit_profile.sh").unlink(missing_ok=True)
    Path("/etc/profile.d/submit_profile.sh").write_text(f"""{GENERATED}
export SUBMITBASEURL={env_value(base_url)}
export SUBMITCREDENTIALS=yes
export SUBMITOMITEXTRAHELP=yes
""")


def apply_management(mgmt, pull_url, start):
    """The VPN, which needs a management server and fleet, and last-minute ansible-pull, which needs a repo"""
    vpn = bool(mgmt["server"] and mgmt["fleet"] and mgmt["vpn"])
    lastminute = bool(pull_url and mgmt["lastminute"])
    running = Path("/run/systemd/system").exists()
    for unit, enabled in [("wg-setup.service", vpn), ("ansible-pull.service", lastminute), ("ansible-pull.path", lastminute)]:
        was_enabled = subprocess.run(["systemctl", "is-enabled", "--quiet", unit]).returncode == 0
        if enabled:
            run(["systemctl", "enable", "--quiet", unit])
            # Only when it's newly turned on: starting ansible-pull.service runs the
            # last-minute playbook, which may itself run icpc-apply
            if running and start and not was_enabled:
                run(["systemctl", "start", "--no-block", unit])
        else:
            run(["systemctl", "disable", "--quiet"] + (["--now"] if running else []) + [unit])


NGINX_SITES = Path("/etc/nginx/icpc-sites.conf")
HOSTS_BEGIN = "# BEGIN reverseproxy_sites, " + GENERATED[2:]
HOSTS_END = "# END reverseproxy_sites"
# Everything here ends up in nginx's config, so nothing may contain ; { } quotes or spaces
HOST_RE = r"[A-Za-z0-9.-]+"
PATH_RE = r"/[^\s;{}\"'\\$]*"


def nginx_site(name, site):
    scheme = site.get("scheme", "https")
    backend = site.get("backend_host", name)
    port = str(site.get("port", ""))
    if not re.fullmatch(HOST_RE, name) or not re.fullmatch(HOST_RE, backend):
        raise ValueError(f"bad host in {name}")
    if scheme not in ("http", "https") or not re.fullmatch(r"\d*", port):
        raise ValueError(f"bad scheme or port for {name}")

    locations = []
    for item in site["paths"]:
        path, exact = item["path"], item.get("exact", False)
        if not re.fullmatch(PATH_RE, path):
            raise ValueError(f"bad path {path!r} for {name}")
        if not exact and path != "/":
            target = "$request_uri"
        else:
            target = (path if path != "/" else "") + ("$is_args$args" if item.get("with_args") else "")
        locations.append(f"""
        location {"=" if exact else ""} {path} {{
                proxy_pass $server_host{target};
        }}""")

    # $server_host being a variable makes nginx look the backend up again when
    # its DNS ttl expires, instead of only once when it starts
    return f"""
server {{
        server_name {name};
        include /etc/nginx/snippets/icpc-proxy.conf;
        set $server_host "{scheme}://{backend}{':' + port if port else ''}";
{"".join(locations)}
}}
"""


def apply_reverseproxy(sites):
    """The contest's allowlist: squid only lets contestants reach 127.0.0.0/8, so
    a site is reachable when /etc/hosts points it at nginx, which proxies it"""
    try:
        conf = GENERATED + "\n" + "".join(nginx_site(name, site) for name, site in sites.items())
    except (AttributeError, KeyError, TypeError, ValueError) as e:
        errors.append(f"reverseproxy_sites isn't valid: {e!r}")
        return
    old = NGINX_SITES.read_text() if NGINX_SITES.exists() else ""
    NGINX_SITES.write_text(conf)
    if not run(["nginx", "-t", "-q"]):
        NGINX_SITES.write_text(old)
        return

    hosts = Path("/etc/hosts").read_text().splitlines()
    hosts = replace_block(hosts, HOSTS_BEGIN, HOSTS_END, [f"127.0.0.1\t{name}" for name in sites])
    Path("/etc/hosts").write_text("\n".join(hosts) + "\n")

    # squid reads /etc/hosts when it starts or reloads. It isn't there in builds
    # that skip the lockdown tag, and systemctl fails on a unit it can't find
    units = [u for u in ("nginx", "squid") if Path(f"/usr/lib/systemd/system/{u}.service").exists()]
    if Path("/run/systemd/system").exists() and units:
        run(["systemctl", "try-reload-or-restart"] + units)


def apply_hostname(team):
    hostname = "icpc-team-" + team["id"]
    Path("/etc/hostname").write_text(hostname + "\n")
    Path("/proc/sys/kernel/hostname").write_text(hostname + "\n")
    # Makes wg_setup tell the VPN about the new hostname
    Path("/run/wg_setup-vpn-hostname-updated").unlink(missing_ok=True)

    hosts = Path("/etc/hosts").read_text().splitlines()
    for i, line in enumerate(hosts):
        if line.startswith("127.0.1.1 "):
            hosts[i] = f"127.0.1.1 {hostname}.icpcnet.internal {hostname}"
    Path("/etc/hosts").write_text("\n".join(hosts) + "\n")


ADMIN = "icpcadmin"
SSH_BEGIN = "# BEGIN ssh_keys, " + GENERATED[2:]
SSH_END = "# END ssh_keys"


def apply_ssh_keys(keys):
    """The config's keys in the admin's authorized_keys, between markers so keys added by hand stay"""
    if not isinstance(keys, list) or not all(isinstance(k, str) and k.strip() and "\n" not in k for k in keys):
        errors.append("ssh_keys isn't a list of authorized_keys lines")
        return
    ssh = Path("/home", ADMIN, ".ssh")
    path = ssh / "authorized_keys"
    ssh.mkdir(mode=0o700, exist_ok=True)
    shutil.chown(ssh, ADMIN, ADMIN)
    lines = path.read_text().splitlines() if path.exists() else []
    path.write_text("\n".join(replace_block(lines, SSH_BEGIN, SSH_END, keys)) + "\n")
    path.chmod(0o600)
    shutil.chown(path, ADMIN, ADMIN)


# An authorized_keys/known_hosts key, without options
KEY_RE = r"(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/]+=*( [^\n]*)?"
# One line of an AuthorizedPrincipalsFile, where # starts a comment and , separates options
PRINCIPAL_RE = r"[^\s,#][^\s,]*"
USER_CAS = Path("/etc/ssh/ca.pub")
PRINCIPALS = Path("/etc/ssh/principals")


def string_list(value, pattern):
    return isinstance(value, list) and all(isinstance(v, str) and re.fullmatch(pattern, v) for v in value)


def apply_ssh_certificates(cas, principals):
    """Let certificates from the user CAs log in as the admin if they carry one of its principals"""
    if not string_list(cas, KEY_RE) or not string_list(principals, PRINCIPAL_RE):
        errors.append("ssh_user_ca_keys or ssh_principals isn't a list of keys or principals, no certificate can log in")
        cas, principals = [], []
    # sshd's TrustedUserCAKeys and AuthorizedPrincipalsFile (playbooks/icpc.yml)
    USER_CAS.write_text("".join(f"{k}\n" for k in cas))
    PRINCIPALS.mkdir(mode=0o755, exist_ok=True)
    (PRINCIPALS / ADMIN).write_text("".join(f"{p}\n" for p in principals))


KNOWN_HOSTS = Path("/etc/ssh/ssh_known_hosts")
KNOWN_HOSTS_BEGIN = "# BEGIN ssh_host_ca_keys, " + GENERATED[2:]
KNOWN_HOSTS_END = "# END ssh_host_ca_keys"


def apply_ssh_host_cas(cas):
    """Trust the management server's host CA for machines in its fleets"""
    if not string_list(cas, KEY_RE):
        errors.append("ssh_host_ca_keys isn't a list of keys")
        cas = []
    lines = KNOWN_HOSTS.read_text().splitlines() if KNOWN_HOSTS.exists() else []
    KNOWN_HOSTS.write_text("\n".join(replace_block(lines, KNOWN_HOSTS_BEGIN, KNOWN_HOSTS_END,
                                                   [f"@cert-authority *.icpcnet.internal {k}" for k in cas])) + "\n")


FIREFOX_POLICIES = Path("/etc/icpc/firefox")


def merge(base, override):
    """base with override's values on top, merging dictionaries key by key"""
    merged = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            value = merge(merged[key], value)
        merged[key] = value
    return merged


def apply_firefox_policies(policies):
    """The image's defaults, then the contest's policies, then what the image needs to work"""
    if not isinstance(policies, dict):
        errors.append("firefox_policies isn't a dictionary")
        return
    defaults = json.loads((FIREFOX_POLICIES / "default-policies.json").read_text())
    fixed = json.loads((FIREFOX_POLICIES / "fixed-policies.json").read_text())
    merged = merge(merge(defaults, policies), fixed)
    path = Path("/usr/lib/firefox/distribution/policies.json")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"policies": merged}, indent=2, ensure_ascii=False) + "\n")


def apply_firefox_autostart(enabled):
    # TODO: this is insufficient... seems like we need to add/remove Hidden=true from the file
    for path in ["/etc/skel/.config/autostart/firefox.desktop", "/home/contestant/.config/autostart/firefox.desktop"]:
        if Path(path).exists():
            Path(path).chmod(0o755 if enabled else 0o000)


WALLPAPER = ICPC / "wallpaper.png"


def fetch_wallpaper(url):
    """Download wallpaper_url to /icpc/wallpaper.png, keeping the last one if that fails"""
    new = ICPC / "wallpaper.png.new"
    try:
        with urllib.request.urlopen(url, timeout=15) as response:
            new.write_bytes(response.read())
    except (OSError, ValueError) as e:
        if WALLPAPER.exists():
            print(f"Couldn't fetch wallpaper_url {url}, keeping the last one: {e}", file=sys.stderr)
        else:
            errors.append(f"Couldn't fetch wallpaper_url {url}: {e}")
        return
    # A captive portal or error page would otherwise become the wallpaper
    if subprocess.run(["identify", str(new)], capture_output=True).returncode != 0:
        new.unlink()
        errors.append(f"wallpaper_url {url} isn't an image")
        return
    new.chmod(0o644)
    new.replace(WALLPAPER)


# xfdesktop caches an image by path, even through `xfdesktop --reload`; only
# changing the property makes it load the file again
RELOAD_BACKDROPS = """
for p in $(xfconf-query -c xfce4-desktop -l | grep '/last-image$'); do
  v=$(xfconf-query -c xfce4-desktop -p "$p")
  xfconf-query -c xfce4-desktop -p "$p" -s ""
  xfconf-query -c xfce4-desktop -p "$p" -s "$v"
done
"""


def reload_desktops():
    """Make every running xfdesktop reread the wallpaper files"""
    out = subprocess.run(["pgrep", "-x", "xfdesktop"], capture_output=True, text=True).stdout
    for pid in out.split():
        proc = Path("/proc", pid)
        try:
            user = proc.owner()
            env = [v for v in (proc / "environ").read_text().split("\0")
                   if v.split("=")[0] in ("DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS", "XDG_RUNTIME_DIR")]
        except OSError:
            continue  # exited
        run(["runuser", "-u", user, "--", "env"] + env + ["sh", "-c", RELOAD_BACKDROPS])


def apply_wallpaper(url, team):
    if url:
        fetch_wallpaper(url)
    wallpaper = ICPC / "teamWallpaper.png"
    if not team:
        wallpaper.unlink(missing_ok=True)
    else:
        run([
            "convert", str(WALLPAPER),
            "-gravity", "center", "-pointsize", "50", "-family", "Ubuntu",
            "-stroke", "#000C", "-strokewidth", "2", "-annotate", "0", team["name"],
            "-stroke", "none", "-fill", "white", "-annotate", "0", team["name"],
            "-pointsize", "30",
            "-stroke", "#000C", "-strokewidth", "2", "-annotate", "+0+60", team["affiliation"],
            "-stroke", "none", "-fill", "white", "-annotate", "+0+60", team["affiliation"],
            str(wallpaper),
        ])
    reload_desktops()


def managed_printers():
    """The PrinterN queues; other queues (like icpc) aren't ours to replace"""
    out = subprocess.run(["lpstat", "-v"], capture_output=True, text=True).stdout
    names = [line.split()[2].rstrip(":") for line in out.splitlines() if line.startswith("device for ")]
    return [n for n in names if n.startswith("Printer")]


def apply_printers(printers, papersize):
    for name in managed_printers():
        run(["lpadmin", "-x", name])
    if subprocess.run(["lpstat", "-c", "ContestPrinter"], capture_output=True).returncode == 0:
        run(["lpadmin", "-x", "ContestPrinter"])

    # CUPS wants the media name capitalized, e.g. media=#Letter
    media = {"letter": "Letter", "a4": "A4"}.get(papersize, papersize)
    names = []
    for i, p in enumerate(printers):
        # A few driver overrides, but everything should use the everywhere driver these days
        driver = {"ps": "drv:///sample.drv/generic.ppd", "pcl": "drv:///sample.drv/generpcl.ppd"}.get(p["driver"], p["driver"])
        name = f"Printer{i}"
        # TODO: acls on printing (default deny? then only allow the contestant to print to what we configure?)
        if not run(["lpadmin", "-p", name, "-v", p["uri"], "-E", "-m", driver, "-L", p.get("note", ""),
                    "-o", f"media=#{media}", "-o", "printer-is-shared=false"] + ERROR_POLICY):
            continue
        # Make sure it's enabled and accepting jobs, in the ContestPrinter class
        if run(["lpadmin", "-p", name, "-c", "ContestPrinter"]) and run(["cupsenable", name]) and run(["cupsaccept", name]):
            names.append(name)

    if names:
        run(["lpadmin", "-d", "ContestPrinter"])
        run(["cupsenable", "ContestPrinter"])
        run(["cupsaccept", "ContestPrinter"])
        # Last: once a queue has an allow list, cupsenable from root fails with not-authorized
        if RESTRICTED:
            for name in names + ["ContestPrinter"]:
                run(["lpadmin", "-p", name] + RESTRICTED)

    # Also restarts icpc-printer, which only sees the hostname it started with
    if ICPC_PRINTER:
        run(["/icpc/scripts/icpc-printer-setup", papersize])


def main(args):
    if args not in ([], ["--no-start"]):
        sys.exit(__doc__.strip())
    config = icpcconfig.load()
    team = config.get("team")

    mgmt = management(config)
    pull_url = ansible_pull_url(config, mgmt)
    apply_files(config, mgmt, pull_url)
    if "papersize" in config:
        apply_papersize(config["papersize"])
    if "timezone" in config:
        apply_timezone(config["timezone"])
    if "language_scripts" in config:
        apply_language_scripts(config["language_scripts"])
    if "submit" in config:
        apply_submit(config["submit"])
    apply_management(mgmt, pull_url, start=not args)
    if "reverseproxy_sites" in config:
        apply_reverseproxy(config["reverseproxy_sites"])
    if team:
        apply_hostname(team)
    if "ssh_keys" in config:
        apply_ssh_keys(config["ssh_keys"])
    apply_ssh_certificates(config.get("ssh_user_ca_keys", []), config.get("ssh_principals", []))
    apply_ssh_host_cas(config.get("ssh_host_ca_keys", []))
    if FIREFOX_POLICIES.exists():
        apply_firefox_policies(config.get("firefox_policies", {}))
    if "autostart_firefox" in config:
        apply_firefox_autostart(config["autostart_firefox"])
    apply_wallpaper(config.get("wallpaper_url"), team)
    if "printers" in config:
        apply_printers(config["printers"], config.get("papersize", "letter"))

    if errors:
        print("\n".join(errors), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
