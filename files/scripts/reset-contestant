#!/bin/bash

# Kill all the user processes(and wait for them to die)
killall -9 -u contestant
sleep 5

DISK=$(blkid -L "ICPC")
if [[ $? == 0 ]]; then
    echo "Wiping FAT32 Partition"
    umount $DISK
    mkfs.vfat $DISK -n ICPC
fi

# find /home/contestant -type d -exec mountpoint {} \;|grep -v not|cut -d" " -f1|tac|xargs umount
umount -f /home/contestant/.vscode/extensions
sleep 1
umount -f /home/contestant/.vscode/extensions-root
sleep 1

rm -rf /home/contestant/.vscode/extensions-work

# Deletes all files owned by the contestant user, then deletes and recreates the account.
echo "Deleting team files"
find / -user contestant -delete

# The next team mustn't be emailed this one's files, or see when it last backed up
rm -rf /var/lib/icpc-backup /run/icpc-backup

# Nor read back this one's printouts (they're root-owned, so the find above
# leaves them)
if [ -d /var/lib/icpc-printer ]; then
    find /var/lib/icpc-printer -mindepth 1 -delete
fi

# Nor which windows this one had open
systemctl stop icpc-focus-log
rm -rf /run/icpc-focus
systemctl start icpc-focus-log

# Nor which programs it ran. auditd can't be stopped by hand, but appends, so
# its open log can be emptied under it
if [ -d /var/log/audit ]; then
    find /var/log/audit -name 'audit.log.*' -delete
    [ -f /var/log/audit/audit.log ] && truncate -s 0 /var/log/audit/audit.log
fi

# Nor which sites it browsed: the proxy's logs and its record of which HTTPS
# hosts it minted certificates for are both root-owned
if [ -d /var/spool/squid/ssl_db ]; then
    systemctl stop squid
    rm -rf /var/log/squid/* /var/spool/squid/ssl_db
    /usr/lib/squid/security_file_certgen -c -s /var/spool/squid/ssl_db -M 4MB
    systemctl start squid
fi

echo "Deleting contestant user"
userdel contestant
rm -rf /home/contestant

echo "Recreating contestant user"
useradd -d /home/contestant -m contestant -s /bin/bash
passwd -d contestant

# touch a file to indicate that the reset is complete (and give us the timestamp if we need it)
echo "Team account reset: $(date -u)" > /icpc/team-reset-complete
