#!/usr/bin/python3

#usage: printfile North.java
#usage: printfile --output=files.ps *.java
#usage: printfile -P printer *.cpp
#usage: printfile --portrait -1 North.hs     [ For those with difficulty with the small print.]

#This script prints contestant source, syntax highlighted: highlight turns it
#into pango markup (bold keywords, italic comments), which paps renders. Both
#are UTF-8 clean, unlike enscript, which only speaks Latin-1. Who printed it is
#added by the print server, not here.

import os
import subprocess
import sys

# highlight's font overrides paps' --font. --force passes files in languages it
# doesn't know through as plain text
HIGHLIGHT = ["/usr/bin/highlight", "--out-format=pango", "--style=print", "--font=Monospace",
             "--font-size=8", "--replace-tabs=4", "--force"]

# -MLetter: we assume US printers and generate letter size pages and not A4
options = ["--paper=letter", "--columns=2", "--landscape"]
printer = None
output = None
files = []

args = sys.argv[1:]
while args:
    arg = args.pop(0)
    if arg == "-P":
        printer = args.pop(0) if args else None
    elif arg.startswith("-P"):
        printer = arg[2:]
    elif arg.startswith("--output="):
        output = arg.split("=", 1)[1]
    elif arg == "--portrait":
        options = [o for o in options if o != "--landscape"]
    elif arg in ("-1", "-2"):
        options = [o for o in options if not o.startswith("--columns=")]
        options.append("--columns=" + arg[1:])
    else:
        files.append(arg)

if not files:
    sys.exit("usage: printfile [-P printer] [--output=file] [--portrait] [-1|-2] file [...]")

lpr = ["/usr/bin/lpr"]
if printer is not None:
    lpr += ["-P", printer]

for path in files:
    # Invalid UTF-8 would make paps silently drop the line it's on
    with open(path, "rb") as handle:
        text = handle.read().decode("utf-8", errors="replace")
    markup = subprocess.run(HIGHLIGHT + ["--syntax-by-name=" + os.path.basename(path)],
                            input=text.encode(), stdout=subprocess.PIPE, check=True).stdout
    paps = ["/usr/bin/paps", "--markup"] + options

    if output is not None:
        with open(output, "ab") as handle:
            subprocess.run(paps, input=markup, stdout=handle, check=True)
    else:
        rendered = subprocess.run(paps, input=markup, stdout=subprocess.PIPE, check=True)
        subprocess.run(lpr + ["-T", os.path.basename(path)], input=rendered.stdout, check=True)
